{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeMail",
  "version": "1.2.1",
  "identifier": "com.khayson.forgemail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ForgeMail",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/khayson/SMTP/releases/latest/download/updater.json"
      ],
      "pubkey": "RWRFkT4ow527QkMBNEsQf0My+wnDz84DYf5eZ7rSKs2sGMdc79nFNvV4"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
